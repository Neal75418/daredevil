#!/bin/bash
# Pre-commit hook for Daredevil
# - Only formats staged .dart files (auto-fix + re-stage)
# - Only analyzes lib/ (skip test/ info-level noise)

set -e

echo "🔍 Running pre-commit CI checks..."

# 0. 補上次沒做完的 CLI 重編(2026-08-15)
#
# post-commit 在背景重編 launchd 的 CLI 產物;失敗或搶不到 lock 時留下
# 這個標記。背景失敗沒人看日誌——那只是把靜默失效換個位置,所以在「下
# 次 commit」這條必經之路上把它撿起來。
#
# 這裡**同步補做**而不是印警告:警告會被忽略,而產物落後的後果是每日
# 自動更新與盤中提醒跑舊邏輯(2026-08-15 實測落後 3 天無人察覺)。
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ -f "$REPO_ROOT/.git/cli-rebuild-pending" ]; then
    echo "🔧 上次 CLI 重編未完成,補做中(約 9s)..."
    if "$REPO_ROOT/ops/launchd/install.sh" --cli-only > /dev/null 2>&1; then
        rm -f "$REPO_ROOT/.git/cli-rebuild-pending"
        echo "✅ CLI 已補上"
    else
        echo "❌ CLI 重編失敗——launchd 的每日更新與盤中提醒會跑舊邏輯"
        echo "   手動查看:ops/launchd/install.sh --cli-only"
        exit 1
    fi
fi

# 1. Auto-format staged .dart files
STAGED_DART=$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')
if [ -n "$STAGED_DART" ]; then
    echo "📝 Formatting $(echo "$STAGED_DART" | wc -l | tr -d ' ') staged .dart files..."
    echo "$STAGED_DART" | xargs dart format
    echo "$STAGED_DART" | xargs git add
    echo "✅ Format OK (auto-fixed & re-staged)"
else
    echo "📝 No staged .dart files to format"
fi

# 2. Analyze lib/ only
echo "🔬 Running static analysis..."
if ! flutter analyze --no-fatal-infos lib/; then
    echo "❌ Analysis failed. Fix the errors above."
    exit 1
fi
echo "✅ Analysis OK"

echo "🎉 All pre-commit checks passed!"
