#!/bin/bash
# Post-commit hook — 讓 launchd 的 CLI 產物跟著 source 走(2026-08-15)
#
# 為什麼需要:launchd 跑的是 AOT 編譯產物,不是 source(`dart run` 會在
# 執行期跑 build hooks 抓網路,2026-08-10 開盤時因此連續 7 輪死在 main()
# 之前)。代價是產物不會自動更新,而落後時**三個訊號全部正常**:exit
# code 0、update_run 記 SUCCESS、日誌無異常——2026-08-15 實測落後 3 天,
# 期間 lib/ 有 14 個 commit,包含當天才修的運維可見性(修了沒生效)。
#
# 重編實測 4.3s/支,便宜到不該由人來記得。
#
# **不碰 launchd**:走 `install.sh --cli-only`。plist 指向固定路徑,換掉
# binary 下一輪喚醒就是新的;反而 bootout/bootstrap 可能打斷盤中那一輪。
#
# **失敗必須被下一次 commit 撞見**:背景執行的東西沒人看日誌,那只是把
# 靜默失效換個位置。失敗寫標記檔,pre-commit 開頭會檢查並大聲講。
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
[ -x "$REPO/ops/launchd/install.sh" ] || exit 0

# CLI 的編譯閉包涵蓋整個 lib/(domain + data + core),不是只有 tool/。
# 靠人工判斷「這次算不算重大改動」本身就是不可靠的判準,所以範圍取寬。
CHANGED="$(git diff-tree --no-commit-id --name-only -r HEAD)"

# 🚨 規則集變動 = 既有 replay 樣本對新規則無效(2026-08-23)
#
# 為什麼放在這裡:唯一能自動判斷「該重跑校準」的訊號是「規則集變了」,而
# recalibrate 的涵蓋診斷住在終端機裡——平常只開 App 的人永遠不會看到它。
# post-commit 是規則變動與人眼唯一的交會點。
#
# 不擋 commit、不自動跑(校準要十幾分鐘且需要 calibration.db),只提醒。
if echo "$CHANGED" | grep -qE '^lib/(domain/services/(rules/|rule_registry)|core/constants/(rule_|reason_type))'; then
  echo ""
  echo "📐 這次 commit 動到規則集——既有的 replay 樣本不含新行為。"
  # 直接把答案算出來(1 秒、唯讀、--dry-run 不寫任何檔),而不是叫人去打
  # 指令:診斷放在使用者不會主動去的地方等於不存在。
  # 缺 calibration.db(換機/新 clone)時工具會安靜退出,這裡也就不印。
  if [ -f "$REPO/tool/calibration.db" ]; then
    COVERAGE="$(cd "$REPO" && dart run tool/recalibrate.dart \
      --db tool/calibration.db --dry-run 2>/dev/null \
      | grep -A2 '所需資料都在')"
    if [ -n "$COVERAGE" ]; then
      echo "$COVERAGE" | sed 's/^/   /'
      echo "   → 重跑 Stage 2(約 12 分鐘):"
      echo "     CALIBRATION_DB=tool/calibration.db flutter test test/tool/run_replay.dart"
    else
      echo "   ✅ 查過了:目前沒有「資料都在但缺樣本」的規則,不用重跑。"
    fi
  else
    echo "   (找不到 tool/calibration.db,略過涵蓋檢查)"
  fi
  echo ""
fi

echo "$CHANGED" \
  | grep -qE '^(lib|bin|tool|ops/launchd)/|^pubspec\.(yaml|lock)$' || exit 0

LOG="$HOME/Library/Logs/daredevil-cli-rebuild.log"
PENDING="$REPO/.git/cli-rebuild-pending"
LOCK="$HOME/.daredevil/cli/.rebuild.lock"
mkdir -p "$HOME/.daredevil/cli" "$HOME/Library/Logs"

# 就地截斷(同 LogRotation 的精神:不放未版控的 newsyslog 設定檔)
[ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1048576 ] && : > "$LOG"

(
  # mkdir 是原子的——連續 commit 時避免兩個 install.sh 同時 rm -rf 同一
  # 個 bundle。搶不到就留 pending 標記,由下次 commit 的 pre-commit 提醒,
  # 不靜默放過(否則後一個 commit 的改動永遠不會進產物)。
  if ! mkdir "$LOCK" 2>/dev/null; then
    date '+%F %T 另一輪重編進行中,留待下次' >> "$LOG"
    touch "$PENDING"
    exit 0
  fi
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT

  sha="$(git -C "$REPO" rev-parse --short HEAD)"
  echo "=== $(date '+%F %T') rebuild for $sha ===" >> "$LOG"
  if "$REPO/ops/launchd/install.sh" --cli-only >> "$LOG" 2>&1; then
    rm -f "$PENDING"
  else
    echo "❌ 重編失敗" >> "$LOG"
    touch "$PENDING"
  fi
) &

exit 0
